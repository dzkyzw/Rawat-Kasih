// aksesObat/{uid}: peran, email, rencanaId (keluarga), or rencanaIds (pramurukti).
// Fungsi 2 · Catatan shift & handover:
// pengaturanPanti/shift: jamMulai (jam mulai tiap shift, 1-6 shift).
// penugasanShift/{rencanaId}: tugas.{uid} = {email, shift: [nomor shift]}; shift kosong = penuh waktu.
// catatanShift/{rencanaId}/catatan/{id}: catatan shift dan siapa yang sudah membacanya.
// Fungsi 4 · Galeri fisik & SOP P3K (dokumentasi tidak pernah dihapus):
// galeriFisik/{rencanaId}/foto/{id}: metadata + thumbnail; subkoleksi gambar/{0..2}, tindakLanjut/{id}, koreksi/v{n}.
// lansiaP04/{rencanaId}: namaLansia, kamar, and an optional primary family account.
// rencanaObat/{rencanaId}: namaLansia, stok, batasStok, jadwal and aksi.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function aksesPengguna() {
      return get(/databases/$(database)/documents/aksesObat/$(request.auth.uid)).data;
    }

    function pramurukti(id) {
      let akses = aksesPengguna();
      return akses.peran == 'PRAMURUKTI' &&
        id in akses.get('rencanaIds', [akses.get('rencanaId', '')]);
    }

    function keluarga(id) {
      let akses = aksesPengguna();
      let profil = get(/databases/$(database)/documents/lansiaP04/$(id)).data;
      return akses.peran == 'KELUARGA' && akses.rencanaId == id &&
        profil.get('keluargaUid', request.auth.uid) == request.auth.uid;
    }

    function admin() {
      return request.auth != null && aksesPengguna().peran == 'ADMIN';
    }

    function namaValid(nama) {
      return nama is string && nama.size() > 0 && nama.size() <= 100;
    }

    function emailValid(email) {
      return email is string && email.size() <= 254 && email.matches('^[^ @]+@[^ @]+[.][^ @]+$');
    }

    function idValid(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    function validAkses(data, uid) {
      let id = data.get('rencanaId', '_');
      let profil = /databases/$(database)/documents/lansiaP04/$(id);
      return (data.peran == 'PRAMURUKTI'
        && data.keys().hasOnly(['peran', 'email', 'rencanaIds'])
        && data.rencanaIds is list && data.rencanaIds.size() <= 50
        && (!('email' in data) || emailValid(data.email)))
        || (data.peran == 'KELUARGA'
          && data.keys().hasOnly(['peran', 'email', 'rencanaId'])
          && data.keys().hasAll(['peran', 'email', 'rencanaId'])
          && idValid(id) && emailValid(data.email)
          && getAfter(profil).data.keluargaUid == uid
          && getAfter(profil).data.emailKeluarga == data.email);
    }

    function validProfil(data, id) {
      let uid = data.get('keluargaUid', '_');
      let akun = /databases/$(database)/documents/aksesObat/$(uid);
      return idValid(id) && namaValid(data.namaLansia)
        && data.keys().hasOnly(['namaLansia', 'kamar', 'keluargaUid', 'emailKeluarga'])
        && data.kamar is string && data.kamar.size() <= 40
        && getAfter(/databases/$(database)/documents/rencanaObat/$(id)).data.namaLansia == data.namaLansia
        && ((!('keluargaUid' in data) && !('emailKeluarga' in data))
          || (idValid(uid) && emailValid(data.emailKeluarga)
            && getAfter(akun).data.peran == 'KELUARGA'
            && getAfter(akun).data.rencanaId == id
            && getAfter(akun).data.email == data.emailKeluarga));
    }

    function validRencanaAwal(data, id) {
      return data.keys().hasOnly(['namaLansia', 'stok', 'batasStok', 'aksi', 'jadwal'])
        && namaValid(data.namaLansia)
        && getAfter(/databases/$(database)/documents/lansiaP04/$(id)).data.namaLansia == data.namaLansia
        && data.stok is int && data.stok == 0 && data.batasStok is int && data.batasStok == 4
        && data.aksi == {'jenis': 'AWAL', 'jam': ''} && data.jadwal == {};
    }
    function jamValid(jam) {
      return jam is string && jam.matches('^([01][0-9]|2[0-3])[.][0-5][0-9]$');
    }

    function validKonfirmasi(lama, baru, jam) {
      return jamValid(jam) && jam in lama.jadwal && jam in baru.jadwal
        && baru.jadwal.diff(lama.jadwal).affectedKeys().hasOnly([jam])
        && lama.jadwal[jam].status == 'BELUM_DIKONFIRMASI'
        && baru.jadwal[jam].keys().hasOnly(['waktu', 'status', 'dicatatOleh', 'dicatatPada', 'alasanPenolakan'])
        && baru.jadwal[jam].waktu == lama.jadwal[jam].waktu
        && baru.jadwal[jam].dicatatOleh == request.auth.uid
        && baru.jadwal[jam].dicatatPada == request.time
        && (!('alasanPenolakan' in baru.jadwal[jam])
          || (baru.jadwal[jam].status == 'DILEWATI'
            && baru.jadwal[jam].alasanPenolakan is string
            && baru.jadwal[jam].alasanPenolakan.size() <= 120))
        && ((baru.jadwal[jam].status == 'DIMINUM' && baru.stok == lama.stok - 1)
          || (baru.jadwal[jam].status == 'DILEWATI' && baru.stok == lama.stok));
    }

    function validPengaturan(lama, baru, jam) {
      return (jam == '' && baru.jadwal == lama.jadwal)
        || (jamValid(jam) && !(jam in lama.jadwal) && jam in baru.jadwal
          && baru.jadwal.size() <= 96
          && baru.jadwal.diff(lama.jadwal).affectedKeys().hasOnly([jam])
          && baru.jadwal[jam].keys().hasOnly(['waktu', 'status'])
          && baru.jadwal[jam].status == 'BELUM_DIKONFIRMASI'
          && baru.jadwal[jam].waktu is string
          && baru.jadwal[jam].waktu.size() > 0
          && baru.jadwal[jam].waktu.size() <= 40);
    }

    function perubahanValid() {
      let lama = resource.data;
      let baru = request.resource.data;
      return baru.diff(lama).affectedKeys().hasOnly(['stok', 'jadwal', 'aksi'])
        && baru.stok is int && baru.stok >= 0 && baru.stok <= 2147483647
        && baru.jadwal is map && baru.aksi is map
        && baru.aksi.keys().hasOnly(['jenis', 'jam'])
        && ((baru.aksi.jenis == 'KONFIRMASI' && validKonfirmasi(lama, baru, baru.aksi.jam))
          || (baru.aksi.jenis == 'PENGATURAN' && validPengaturan(lama, baru, baru.aksi.jam)));
    }

    match /aksesObat/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || admin();
      allow list: if admin() && resource.data.peran == 'PRAMURUKTI';
      allow create: if admin() && request.auth.uid != uid && validAkses(request.resource.data, uid);
      allow update: if admin() && request.auth.uid != uid
        && resource.data.peran == request.resource.data.peran
        && (resource.data.peran != 'KELUARGA' || resource.data.rencanaId == request.resource.data.rencanaId)
        && validAkses(request.resource.data, uid);
    }

    match /lansiaP04/{id} {
      allow get, list: if admin();
      allow create, update: if admin() && validProfil(request.resource.data, id);
    }

    match /rencanaObat/{id} {
      allow get: if admin() || (request.auth != null && (pramurukti(id) || keluarga(id)));
      allow create: if admin() && validRencanaAwal(request.resource.data, id);
      allow update: if (request.auth != null && pramurukti(id) && perubahanValid())
        || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['namaLansia'])
          && namaValid(request.resource.data.namaLansia)
          && getAfter(/databases/$(database)/documents/lansiaP04/$(id)).data.namaLansia
            == request.resource.data.namaLansia);
    }

    function validCatatan(data) {
      return data.keys().hasOnly(['penulisUid', 'penulisEmail', 'shift', 'mood', 'isi', 'waktu'])
        && data.keys().hasAll(['penulisUid', 'penulisEmail', 'shift', 'mood', 'isi', 'waktu'])
        && data.penulisUid == request.auth.uid
        && data.penulisEmail == request.auth.token.email
        && data.shift is string && data.shift.size() <= 40
        && data.mood in ['TENANG', 'SENANG', 'SEDIH', 'GELISAH']
        && data.isi is string && data.isi.size() >= 10 && data.isi.size() <= 2000
        && data.waktu == request.time;
    }

    match /pengaturanPanti/shift {
      allow get: if request.auth != null;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['jamMulai'])
        && request.resource.data.jamMulai is list
        && request.resource.data.jamMulai.size() >= 1 && request.resource.data.jamMulai.size() <= 6;
    }

    match /penugasanShift/{id} {
      allow get: if admin() || (request.auth != null && pramurukti(id));
      allow list: if admin();
      allow create, update: if admin() && idValid(id)
        && exists(/databases/$(database)/documents/lansiaP04/$(id))
        && request.resource.data.keys().hasOnly(['tugas'])
        && request.resource.data.tugas is map && request.resource.data.tugas.size() <= 50;
    }

    match /catatanShift/{id}/catatan/{catatanId} {
      allow list: if admin() || (request.auth != null && pramurukti(id));
      allow create: if request.auth != null && pramurukti(id) && validCatatan(request.resource.data);
      // Hanya pramurukti lain yang ditugaskan ke lansia ini yang boleh mengonfirmasi, sekali saja.
      allow update: if request.auth != null && pramurukti(id)
        && !('dibacaOlehUid' in resource.data)
        && resource.data.penulisUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dibacaOlehUid', 'dibacaOlehEmail', 'dibacaPada'])
        && request.resource.data.dibacaOlehUid == request.auth.uid
        && request.resource.data.dibacaOlehEmail == request.auth.token.email
        && request.resource.data.dibacaPada == request.time;
    }

    // ---------------- Fungsi 4 · Galeri fisik & SOP P3K ----------------
    function bacaGaleri(id) {
      return admin() || (request.auth != null && (pramurukti(id) || keluarga(id)));
    }

    function teksValid(t, min, maks) {
      return t is string && t.size() >= min && t.size() <= maks;
    }

    function kategoriValid(k) {
      return k in ['LUKA_KULIT', 'MEMAR', 'BENGKAK', 'LAINNYA'];
    }

    function sopValid(s) {
      return s in ['', 'lecet', 'luka-tekan', 'memar', 'bengkak', 'jatuh', 'suhu'];
    }

    function dokFoto(id, fotoId) {
      return /databases/$(database)/documents/galeriFisik/$(id)/foto/$(fotoId);
    }

    function validFoto(data, id, fotoId) {
      return data.keys().hasOnly(['kategori', 'keparahan', 'lokasi', 'observasi', 'thumbnail', 'jumlahFoto', 'sopId', 'tandaBahaya',
          'perluDokter', 'alasanDokter', 'ditangani', 'versi', 'pengunggahUid', 'pengunggahEmail', 'waktu', 'diubahPada'])
        && data.keys().hasAll(['kategori', 'keparahan', 'lokasi', 'observasi', 'thumbnail', 'jumlahFoto', 'sopId', 'tandaBahaya',
          'perluDokter', 'alasanDokter', 'ditangani', 'versi', 'pengunggahUid', 'pengunggahEmail', 'waktu', 'diubahPada'])
        && kategoriValid(data.kategori)
        // Keparahan (flowchart 2.2.4): Parah/Darurat wajib "perlu dokter".
        && data.keparahan in ['RINGAN', 'SEDANG', 'PARAH', 'DARURAT']
        && (!(data.keparahan in ['PARAH', 'DARURAT']) || data.perluDokter == true) && teksValid(data.lokasi, 1, 60) && teksValid(data.observasi, 5, 500)
        && teksValid(data.thumbnail, 1, 60000)
        && data.jumlahFoto is int && data.jumlahFoto >= 1 && data.jumlahFoto <= 3
        && sopValid(data.sopId)
        && data.tandaBahaya is list && data.tandaBahaya.size() <= 14
        && data.tandaBahaya.toSet().hasOnly(['LUKA_DALAM', 'BERDARAH_TERUS', 'TIDAK_SEHAT', 'KULIT_TERBUKA', 'INFEKSI', 'DEMAM',
          'MEMBESAR_CEPAT', 'SANGAT_NYERI', 'SETELAH_JATUH', 'PINGSAN', 'TIDAK_BISA_BERGERAK', 'SESAK', 'SATU_TUNGKAI', 'SUHU_MENETAP'])
        && data.perluDokter is bool && data.alasanDokter is list && data.alasanDokter.size() <= 20
        // Aturan minimum mesin P3K di server: ada tanda bahaya → wajib "perlu dokter", dan selalu disertai alasan.
        && (data.tandaBahaya.size() == 0 || data.perluDokter == true)
        && data.perluDokter == (data.alasanDokter.size() > 0)
        && data.ditangani == false && data.versi == 1
        && data.pengunggahUid == request.auth.uid
        && data.pengunggahEmail == request.auth.token.email
        && data.waktu == request.time && data.diubahPada == request.time
        // Foto pertama wajib ikut tersimpan dalam batch yang sama.
        && existsAfter(/databases/$(database)/documents/galeriFisik/$(id)/foto/$(fotoId)/gambar/0);
    }

    function validDitangani() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ditangani'])
        && request.resource.data.ditangani == true;
    }

    function validKoreksiFoto(id, fotoId) {
      let baru = request.resource.data;
      return baru.diff(resource.data).affectedKeys().hasOnly(['kategori', 'lokasi', 'sopId', 'versi', 'diubahPada'])
        && kategoriValid(baru.kategori) && teksValid(baru.lokasi, 1, 60) && sopValid(baru.sopId)
        && baru.versi == resource.data.versi + 1 && baru.diubahPada == request.time
        && existsAfter(/databases/$(database)/documents/galeriFisik/$(id)/foto/$(fotoId)/koreksi/$('v' + string(baru.versi)));
    }

    function validKoreksi(d, id, fotoId, kid) {
      let lama = get(dokFoto(id, fotoId)).data;
      return d.keys().hasOnly(['versi', 'perubahan', 'alasan', 'sebelum', 'olehUid', 'olehEmail', 'waktu'])
        && d.versi is int && kid == 'v' + string(d.versi)
        && getAfter(dokFoto(id, fotoId)).data.versi == d.versi && lama.versi + 1 == d.versi
        && d.perubahan is list && d.perubahan.size() >= 1 && d.perubahan.size() <= 4
        && d.alasan in ['SALAH_PILIH', 'SALAH_KETIK', 'INFO_TAMBAHAN', 'LAINNYA']
        && d.sebelum is map && d.sebelum.kategori == lama.kategori && d.sebelum.lokasi == lama.lokasi
        && d.olehUid == request.auth.uid && d.olehEmail == request.auth.token.email
        && d.waktu == request.time;
    }

    function validTindakLanjut(d) {
      return d.keys().hasOnly(['tindakan', 'status', 'waktu', 'petugasUid', 'petugasEmail', 'dibuat'])
        && teksValid(d.tindakan, 3, 300)
        && ((d.status == 'SELESAI' && d.waktu == request.time)
          || (d.status == 'TERJADWAL' && d.waktu is timestamp && d.waktu > request.time
            && d.waktu < request.time + duration.value(30, 'd')))
        && d.petugasUid == request.auth.uid && d.petugasEmail == request.auth.token.email
        && d.dibuat == request.time;
    }

    match /galeriFisik/{id}/foto/{fotoId} {
      allow get, list: if bacaGaleri(id);
      allow create: if request.auth != null && pramurukti(id) && validFoto(request.resource.data, id, fotoId);
      allow update: if request.auth != null && (
        ((pramurukti(id) || admin()) && validDitangani())
        || (pramurukti(id) && validKoreksiFoto(id, fotoId)));
      // Tidak ada aturan delete: dokumentasi tidak bisa dihapus, hanya dikoreksi.

      match /gambar/{n} {
        allow get, list: if bacaGaleri(id);
        // Foto hanya ditambahkan bersamaan dengan dokumentasinya, oleh pengunggah yang sama.
        allow create: if request.auth != null && pramurukti(id) && n in ['0', '1', '2']
          && request.resource.data.keys().hasOnly(['urutan', 'data'])
          && request.resource.data.urutan is int && string(request.resource.data.urutan) == n
          && teksValid(request.resource.data.data, 1, 700000)
          && getAfter(dokFoto(id, fotoId)).data.pengunggahUid == request.auth.uid
          && getAfter(dokFoto(id, fotoId)).data.waktu == request.time;
      }

      match /tindakLanjut/{tindakId} {
        allow get, list: if bacaGaleri(id);
        allow create: if request.auth != null && (pramurukti(id) || admin())
          && exists(dokFoto(id, fotoId)) && validTindakLanjut(request.resource.data);
      }

      match /koreksi/{koreksiId} {
        allow get, list: if bacaGaleri(id);
        allow create: if request.auth != null && pramurukti(id) && validKoreksi(request.resource.data, id, fotoId, koreksiId);
      }
    }
  }
}
